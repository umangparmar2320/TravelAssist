# ==============================================================================
# SMART ROUTE PLANNER - PART A FOUNDATION CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Smart Route Planner - Part A"
API_V1_STR="/api/v1"
SECRET_KEY="supersecret-part-a-dev-key-replace-in-production"

# Server Ports & Host
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL)
# For remote PostgreSQL or local docker: postgresql+psycopg2://postgres:postgres@localhost:5432/route_planner_db
# In development without an external PostgreSQL instance, our database manager will safely fallback to SQLite.
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/route_planner_db"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# CORS Configuration (comma-separated list of allowed origins or *)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s:%(funcName)s:%(lineno)d - %(message)s"

# Part A Real-Time Travel Provider Configuration
ROUTE_PROVIDER_DEFAULT="mock_provider"
ROUTE_PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_TIMEOUT_SECONDS=10

# Flight Providers
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AVIATIONSTACK_API_KEY=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Train & Ground Providers
OPENROUTESERVICE_API_KEY=
QRAIL_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
NOMINATIM_USER_AGENT="SmartRoutePlanner/1.0"
OSRM_BASE_URL="https://router.project-osrm.org"
AMTRAKER_BASE_URL="https://api.amtraker.com/v3"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
PHOTON_BASE_URL="https://photon.komoot.io/api"

# AI & Real-Time & Notifications
GEMINI_API_KEY=
REDIS_URL=
TELEGRAM_BOT_TOKEN=
